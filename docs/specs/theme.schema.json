{
  "$defs": {
    "BuzzerSegmentDef": {
      "additionalProperties": false,
      "description": "单个蜂鸣音调或静音间隔。",
      "properties": {
        "duration_ms": {
          "description": "片段持续时间毫秒数，必须大于 0。",
          "examples": [
            160
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "frequency_hz": {
          "description": "频率 Hz；0 表示静音间隔，其他值还需满足设备能力范围。",
          "examples": [
            880
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "volume": {
          "description": "蜂鸣音量，范围 0~100。",
          "examples": [
            70
          ],
          "format": "uint8",
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "frequency_hz",
        "duration_ms",
        "volume"
      ],
      "type": "object"
    },
    "BuzzerTrackDef": {
      "additionalProperties": false,
      "description": "蜂鸣器播放轨道。",
      "properties": {
        "repeat": {
          "default": null,
          "description": "整组片段重复次数；0 或省略表示持续循环。",
          "examples": [
            1
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "segments": {
          "description": "按顺序播放的蜂鸣片段，数量为 1~16。",
          "items": {
            "$ref": "#/$defs/BuzzerSegmentDef"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "start_delay_ms": {
          "default": null,
          "description": "开始播放前的延迟毫秒数。",
          "examples": [
            120
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "segments"
      ],
      "type": "object"
    },
    "EndLevel": {
      "description": "有限重复结束后的灯轨电平。",
      "oneOf": [
        {
          "const": "OFF",
          "description": "熄灭。",
          "type": "string"
        },
        {
          "const": "LOW",
          "description": "保持低点颜色。",
          "type": "string"
        },
        {
          "const": "HIGH",
          "description": "保持高点颜色。",
          "type": "string"
        }
      ]
    },
    "LedTrackDef": {
      "description": "单条灯轨。不同 curve 使用互斥的字段约束。",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "brightness": {
              "description": "整条灯轨亮度，范围 0~100。",
              "examples": [
                60
              ],
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "curve": {
              "const": "CONSTANT",
              "description": "静态常亮曲线。",
              "examples": [
                "CONSTANT"
              ]
            },
            "duty_percent": {
              "const": 0,
              "description": "CONSTANT 曲线不使用占空比。",
              "type": "integer"
            },
            "end_level": {
              "allOf": [
                {
                  "$ref": "#/$defs/EndLevel"
                }
              ],
              "description": "有限重复完成后的输出电平。",
              "examples": [
                "OFF"
              ]
            },
            "high": {
              "description": "RGB 十六进制颜色，格式为 #RRGGBB。",
              "examples": [
                "#168CFF"
              ],
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "low": {
              "description": "RGB 十六进制颜色，格式为 #RRGGBB。",
              "examples": [
                "#168CFF"
              ],
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "period_ms": {
              "const": 0,
              "description": "CONSTANT 曲线的周期只能省略或为 0。",
              "type": "integer"
            },
            "phase_deg": {
              "description": "波形相位角，范围 0~360。",
              "examples": [
                120
              ],
              "maximum": 360,
              "minimum": 0,
              "type": "integer"
            },
            "repeat": {
              "description": "有限重复次数；0 或省略表示持续运行。",
              "examples": [
                3
              ],
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "curve",
            "high",
            "brightness"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "brightness": {
              "description": "整条灯轨亮度，范围 0~100。",
              "examples": [
                60
              ],
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "curve": {
              "const": "SQUARE",
              "description": "方波闪烁曲线。",
              "examples": [
                "SQUARE"
              ]
            },
            "duty_percent": {
              "description": "方波高电平占比。",
              "examples": [
                50
              ],
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            },
            "end_level": {
              "allOf": [
                {
                  "$ref": "#/$defs/EndLevel"
                }
              ],
              "description": "有限重复完成后的输出电平。",
              "examples": [
                "OFF"
              ]
            },
            "high": {
              "description": "RGB 十六进制颜色，格式为 #RRGGBB。",
              "examples": [
                "#168CFF"
              ],
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "low": {
              "description": "RGB 十六进制颜色，格式为 #RRGGBB。",
              "examples": [
                "#168CFF"
              ],
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "period_ms": {
              "description": "完整方波周期毫秒数。",
              "examples": [
                1000
              ],
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "phase_deg": {
              "description": "波形相位角，范围 0~360。",
              "examples": [
                120
              ],
              "maximum": 360,
              "minimum": 0,
              "type": "integer"
            },
            "repeat": {
              "description": "有限重复次数；0 或省略表示持续运行。",
              "examples": [
                3
              ],
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "curve",
            "high",
            "brightness",
            "period_ms",
            "duty_percent"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "brightness": {
              "description": "整条灯轨亮度，范围 0~100。",
              "examples": [
                60
              ],
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "curve": {
              "description": "呼吸、渐亮或渐弱曲线。",
              "enum": [
                "TRIANGLE",
                "SAW_UP",
                "SAW_DOWN"
              ],
              "examples": [
                "TRIANGLE"
              ]
            },
            "duty_percent": {
              "const": 0,
              "description": "非 SQUARE 曲线不使用占空比。",
              "type": "integer"
            },
            "end_level": {
              "allOf": [
                {
                  "$ref": "#/$defs/EndLevel"
                }
              ],
              "description": "有限重复完成后的输出电平。",
              "examples": [
                "OFF"
              ]
            },
            "high": {
              "description": "RGB 十六进制颜色，格式为 #RRGGBB。",
              "examples": [
                "#168CFF"
              ],
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "low": {
              "description": "RGB 十六进制颜色，格式为 #RRGGBB。",
              "examples": [
                "#168CFF"
              ],
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "period_ms": {
              "description": "完整波形周期毫秒数。",
              "examples": [
                1600
              ],
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "phase_deg": {
              "description": "波形相位角，范围 0~360。",
              "examples": [
                120
              ],
              "maximum": 360,
              "minimum": 0,
              "type": "integer"
            },
            "repeat": {
              "description": "有限重复次数；0 或省略表示持续运行。",
              "examples": [
                3
              ],
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "curve",
            "high",
            "brightness",
            "period_ms"
          ],
          "type": "object"
        }
      ]
    },
    "Scene": {
      "additionalProperties": false,
      "description": "一组可同时执行的三灯轨道与可选蜂鸣轨道。",
      "properties": {
        "buzzer": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuzzerTrackDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "可选蜂鸣轨道；省略或 null 表示静音。"
        },
        "leds": {
          "description": "顶、中、底三条灯轨；null 表示该灯输出黑色。",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/LedTrackDef"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "leds"
      ],
      "type": "object"
    },
    "StateConfig": {
      "additionalProperties": false,
      "description": "单个业务状态的场景映射与切换语义。",
      "properties": {
        "hold_ms": {
          "default": null,
          "description": "终态驻留时长毫秒数；0 或省略表示不自动回落。",
          "examples": [
            2000
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scene": {
          "description": "引用当前主题 scenes 中存在的场景名称。",
          "examples": [
            "working"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "transition_ms": {
          "default": null,
          "description": "进入状态时的过渡时长，范围 0~2500 毫秒。",
          "examples": [
            180
          ],
          "format": "uint16",
          "maximum": 2500,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "scene"
      ],
      "type": "object"
    },
    "ThemeMeta": {
      "additionalProperties": false,
      "description": "主题元信息。",
      "properties": {
        "name": {
          "description": "主题名称，只允许字母、数字、下划线和连字符。",
          "examples": [
            "aurora"
          ],
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "version": {
          "const": 1,
          "description": "主题格式版本，当前固定为 1。",
          "examples": [
            1
          ],
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://ai-light.local/schemas/theme-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AI-Light 主题文件格式 V1：状态到灯光与声音场景的映射。",
  "properties": {
    "scenes": {
      "additionalProperties": {
        "$ref": "#/$defs/Scene"
      },
      "description": "可复用的命名灯光/声音场景；至少包含一个场景。",
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "object"
    },
    "states": {
      "additionalProperties": {
        "$ref": "#/$defs/StateConfig"
      },
      "description": "业务状态到场景名称的映射。",
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "object"
    },
    "theme": {
      "$ref": "#/$defs/ThemeMeta",
      "description": "主题名称与格式版本。"
    }
  },
  "required": [
    "theme",
    "scenes",
    "states"
  ],
  "title": "AI-Light Theme",
  "type": "object"
}
